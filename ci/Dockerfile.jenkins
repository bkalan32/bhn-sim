# Jenkins with the tools the pipeline needs: docker CLI, kubectl, kind, python.
#
# LAB SHORTCUT, DO NOT COPY TO PRODUCTION: this runs as root with the host's Docker
# socket mounted. That is equivalent to root on the host. A real company runs build
# agents as separate pods with scoped credentials. Noted in the README.
FROM jenkins/jenkins:lts
USER root
ARG KIND_VERSION=v0.33.0
ARG DOCKER_CLI_VERSION=28.5.2

RUN apt-get update && apt-get install -y --no-install-recommends \
      python3 python3-venv python3-pip curl git ca-certificates jq \
 && rm -rf /var/lib/apt/lists/*

# FIX: the distro's docker.io package is not reliable across the Debian releases the
# jenkins:lts image moves between. We only need the CLI (the daemon is Docker Desktop's,
# via the mounted socket), so take it from Docker's own static builds.
RUN ARCH="$(dpkg --print-architecture)"; case "$ARCH" in amd64) DA=x86_64;; arm64) DA=aarch64;; *) DA="$ARCH";; esac \
 && curl -fsSL "https://download.docker.com/linux/static/stable/${DA}/docker-${DOCKER_CLI_VERSION}.tgz" \
    | tar -xz -C /usr/local/bin --strip-components=1 docker/docker \
 && chmod +x /usr/local/bin/docker \
 && docker --version

RUN ARCH="$(dpkg --print-architecture)" \
 && curl -fsSLo /usr/local/bin/kubectl "https://dl.k8s.io/release/$(curl -fsSL https://dl.k8s.io/release/stable.txt)/bin/linux/${ARCH}/kubectl" \
 && chmod +x /usr/local/bin/kubectl \
 && curl -fsSLo /usr/local/bin/kind "https://kind.sigs.k8s.io/dl/${KIND_VERSION}/kind-linux-${ARCH}" \
 && chmod +x /usr/local/bin/kind \
 && kubectl version --client && kind --version

# /repo is bind-mounted from your home dir and owned by your WSL uid. Jenkins runs as
# root here, so git refuses with "detected dubious ownership" — for both the pipeline's
# `git clone /repo` and the job's own SCM checkout.
RUN git config --system --add safe.directory '*'
