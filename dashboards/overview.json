{
 "__inputs": [
  {
   "name": "DS_PROMETHEUS",
   "label": "Prometheus",
   "type": "datasource",
   "pluginId": "prometheus",
   "pluginName": "Prometheus"
  }
 ],
 "__requires": [
  {
   "type": "grafana",
   "id": "grafana",
   "name": "Grafana",
   "version": "11.0.0"
  },
  {
   "type": "datasource",
   "id": "prometheus",
   "name": "Prometheus",
   "version": "1.0.0"
  },
  {
   "type": "panel",
   "id": "annolist",
   "name": "Annotations list",
   "version": ""
  }
 ],
 "annotations": {
  "list": [
   {
    "datasource": {
     "type": "grafana",
     "uid": "-- Grafana --"
    },
    "enable": true,
    "hide": false,
    "iconColor": "#5794F2",
    "name": "Deploys",
    "target": {
     "limit": 100,
     "matchAny": false,
     "tags": [
      "deploy"
     ],
     "type": "tags"
    }
   },
   {
    "datasource": {
     "type": "grafana",
     "uid": "-- Grafana --"
    },
    "enable": true,
    "hide": false,
    "iconColor": "#F2495C",
    "name": "Rollbacks",
    "target": {
     "limit": 100,
     "matchAny": false,
     "tags": [
      "rollback"
     ],
     "type": "tags"
    }
   }
  ]
 },
 "editable": true,
 "graphTooltip": 1,
 "panels": [
  {
   "type": "row",
   "title": "Platform",
   "gridPos": {
    "h": 1,
    "w": 24,
    "x": 0,
    "y": 0
   },
   "collapsed": false,
   "panels": []
  },
  {
   "type": "stat",
   "title": "Platform health",
   "description": "Average of the three service scores. docs/health-score.md is the opinion behind it.",
   "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROMETHEUS}"
   },
   "gridPos": {
    "h": 5,
    "w": 6,
    "x": 0,
    "y": 1
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${DS_PROMETHEUS}"
     },
     "editorMode": "code",
     "expr": "platform:health_score",
     "legendFormat": "__auto",
     "range": true,
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "decimals": 0,
     "color": {
      "mode": "thresholds"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "red",
        "value": null
       },
       {
        "color": "yellow",
        "value": 70
       },
       {
        "color": "green",
        "value": 90
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "colorMode": "background",
    "graphMode": "area",
    "justifyMode": "center",
    "textMode": "value",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    }
   }
  },
  {
   "type": "stat",
   "title": "Active critical alerts",
   "description": "Only YOUR rules (they carry a service label). kube-prometheus-stack's kind false positives (scheduler/controller-manager/proxy 'down') are excluded here \u2014 and silenced in Alertmanager \u2014 but ALERTS in Prometheus would still count them.",
   "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROMETHEUS}"
   },
   "gridPos": {
    "h": 5,
    "w": 4,
    "x": 6,
    "y": 1
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${DS_PROMETHEUS}"
     },
     "editorMode": "code",
     "expr": "count(ALERTS{alertstate=\"firing\", severity=\"critical\", service=~\"activation|egift|settlement\"}) or vector(0)",
     "legendFormat": "__auto",
     "range": true,
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "decimals": 0,
     "color": {
      "mode": "thresholds"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "red",
        "value": 1
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "colorMode": "background",
    "graphMode": "none",
    "justifyMode": "center",
    "textMode": "value",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    }
   }
  },
